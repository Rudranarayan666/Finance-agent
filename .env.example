# Project Settings
PROJECT_NAME="Financial Report Analyzer Agent"
ENV="development"
DEBUG=True

# Security & Auth
SECRET_KEY="your-super-secret-key-32-bytes-min"
JWT_SECRET="your-jwt-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL / SQLite fallback)
DATABASE_URL="sqlite:///./finance_agent.db"
# DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres"

# LLM Providers (Required for live API generation)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"

# OAuth Authentication (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Service (Resend)
RESEND_API_KEY=""

# Vector DB & Storage
STORAGE_PATH="./uploads"
UPLOAD_DIR="./uploads"
CHROMA_PERSIST_DIR="./chroma_db"
USE_REAL_DENSE_RETRIEVER=False
DENSE_EMBEDDING_BACKEND="local"
DENSE_MODEL_NAME="BAAI/bge-small-en-v1.5"
USE_CROSS_ENCODER_RERANKER=False
RERANKER_MODEL_NAME="BAAI/bge-reranker-base"
RERANKER_TOP_N=4
USE_TABLE_AWARE_CHUNKING=False
USE_PERIOD_UNIT_AWARENESS=False
RRF_K=60.0
RRF_BM25_WEIGHT=1.0
RRF_DENSE_WEIGHT=1.0
ENABLE_LLM_GROUNDED_SYNTHESIS=False

# LLM-as-Judge & Evaluation
USE_LLM_JUDGE=False
JUDGE_BACKEND="local"
JUDGE_MODEL="meta/llama-3.1-70b-instruct"
JUDGE_TEMPERATURE=0.0
JUDGE_PASS_THRESHOLD=0.70
MAX_UPLOAD_SIZE_MB=50
DATA_RETENTION_DAYS=30

# SaaS Administrative Bootstrap Credentials
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="admin123456"

# SaaS Credit Cost Configuration
UPLOAD_CREDIT_COST=10
QUESTION_CREDIT_COST=15
VISUAL_ANALYSIS_CREDIT_COST=10

# Razorpay Payment Gateway (Indian Market Sandbox / Test Mode)
PAYMENT_TEST_MODE=True
RAZORPAY_KEY_ID="rzp_test_YourRazorpayKeyId"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecret"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecret"
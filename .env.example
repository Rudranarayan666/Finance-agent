# Project Settings
PROJECT_NAME="Financial Report Analyzer Agent"
ENV="development"
DEBUG=True

# Security & Auth
SECRET_KEY="your-super-secret-key-32-bytes-min"
JWT_SECRET="your-jwt-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL / SQLite fallback)
DATABASE_URL="sqlite:///./finance_agent.db"
# DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres"

# LLM Providers (Required for live API generation)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""

# OAuth Authentication (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Service (Resend)
RESEND_API_KEY=""

# Vector DB & Storage
STORAGE_PATH="./uploads"
UPLOAD_DIR="./uploads"
CHROMA_PERSIST_DIR="./chroma_db"
MAX_UPLOAD_SIZE_MB=50
DATA_RETENTION_DAYS=30